pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                dir('9-Jenkins-MultiStage-Pipeline') {
                    echo 'Creating virtual environment and installing dependencies...'
                    sh '''
                        python3 -m venv .venv
                        .venv/bin/pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                dir('9-Jenkins-MultiStage-Pipeline') {
                    echo 'Running tests...'
                    sh '''
                        .venv/bin/python -m unittest discover -s . -p "test_*.py"
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                dir('9-Jenkins-MultiStage-Pipeline') {
                    echo 'Deploying application...'
                    sh '''
                        mkdir -p "$WORKSPACE/python-app-deploy"
                        cp app.py requirements.txt "$WORKSPACE/python-app-deploy/"
                    '''
                }
            }
        }

        stage('Run Application') {
            steps {
                echo 'Running application...'
                sh '''
                    cd "$WORKSPACE/python-app-deploy"

                    if [ -f app.pid ]; then
                        kill "$(cat app.pid)" 2>/dev/null || true
                    fi

                    nohup "$WORKSPACE/9-Jenkins-MultiStage-Pipeline/.venv/bin/python" app.py \
                        > app.log 2>&1 &

                    echo $! > app.pid
                '''
            }
        }

        stage('Test Application') {
            steps {
                dir('9-Jenkins-MultiStage-Pipeline') {
                    echo 'Testing deployed application...'
                    sh '''
                        .venv/bin/python -c "
from app import app
response = app.test_client().get('/')
assert response.status_code == 200
assert response.get_data(as_text=True) == 'Hello, Jenkins Multi-Stage Pipeline!'
print('Application test passed!')
"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the logs for more details.'
        }
        always {
            echo 'Pipeline execution finished.'
        }
    }
}
